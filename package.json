{
  "name": "flue-pr-review",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "run": "flue run agents/pr-review.ts",
    "demo": "flue run agents/pr-review.ts --id demo-deepseek --data \"$(cat fixtures/demo-pr.json)\" --message \"このPRをレビューせよ\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test agents/*.test.ts domain/*.test.ts prompts/*.test.ts tools/*.test.ts"
  },
  "dependencies": {
    "@flue/github": "^2.0.3",
    "@flue/runtime": "^2.0.3",
    "@flue/vite": "^2.0.3",
    "@octokit/rest": "^22.0.1",
    "hono": "4.12.32",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@flue/cli": "^2.0.3",
    "typescript": "^5.6.0",
    "vite": "^8.0.0"
  }
}
